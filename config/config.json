{
    "feed_url": "https://sentrydigest.ricomanifesto.com/feed.xml",
    "output_path": "index.md",
    "analysis": {
        "model": "openrouter/nvidia/nemotron-3.5-super-vl:free",
        "grounding": "advisory",
        "max_tokens": 32000,
        "max_input_tokens": 200000,
        "triage": {
            "mode": "enabled",
            "min_probability": 0.95,
            "timeout_seconds": 8
        },
        "temperature": 1,
        "analysis_focus": [
            "zero-day vulnerabilities",
            "active exploitation",
            "patch releases",
            "critical vulnerabilities",
            "threat actor activities"
        ]
    },
    "report": {
        "include_date": true,
        "include_source_links": true,
        "format": "markdown"
    },
    "fetch": {
        "timeout": 30,
        "max_retries": 3,
        "content_extraction": "full"
    },
    "logging": {
        "level": "INFO",
        "file": "sentry_digest.log"
    }
}
